{
	"name": "ff2-for-st-jude-api",
	"version": "2.0.0",
	"description": "API for 'FF7 for St. Jude' charity event.",
	"main": "dist/index.js",
	"type": "module",
	"keywords": [],
	"author": "displaycoffee",
	"license": "ISC",
	"homepage": "https://api.ff7forstjude.org",
	"scripts": {
		"build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --format=esm --packages=external",
		"dev": "tsx watch src/index.ts",
		"format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
		"start": "node dist/index.js"
	},
	"devDependencies": {
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^25.5.0",
		"esbuild": "^0.27.4",
		"nodemon": "^3.1.14",
		"prettier": "^3.8.1",
		"ts-node": "^10.9.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"cors": "^2.8.6",
		"dotenv": "^17.3.1",
		"express": "^5.2.1",
		"node-fetch": "^3.3.2"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/displaycoffee/ff7-for-st-jude-api.git"
	},
